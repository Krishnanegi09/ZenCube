{
  "version": 2,
  "builds": [
    {
      "src": "web_dashboard.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/web_dashboard.py"
    }
  ],
  "functions": {
    "web_dashboard.py": {
      "includeFiles": "templates/**",
      "maxDuration": 60
    }
  }
}

